# Backend API base URL.
# In dev (default for this repo): http://localhost:4000 — set PORT in root .env if you use another port.
# In Railway prod with rewrites: leave blank or set to /backend-api
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: min interval (ms) for shared project status polling in the browser.
# Default 8000. Increase if you still see too many GET /api/projects/:id in Network.
# NEXT_PUBLIC_PROJECT_POLL_MS=12000

# Internal URL used by next.config.js rewrites for Railway private networking.
# Set this when you want the backend to stay internal.
# BACKEND_INTERNAL_URL=http://backend.railway.internal:4000
